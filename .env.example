# Foody Music — environment variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# AI Concierge (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------

# Required for real AI-generated recipes via OpenAI.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset.
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Supabase (required after migration off DatabasePad)
# ---------------------------------------------------------------------------
#
# Create a project at https://supabase.com, run the migrations in supabase/migrations/,
# then paste your project credentials here. See also .env.supabase.example and
# docs/SUPABASE_MIGRATION_PLAN.md.
#
# Browser and server both use these VITE_* names (also set the same values on Vercel):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Cookbook Builder (database migration required)
# ---------------------------------------------------------------------------
#
# Run all SQL migrations listed in docs/SUPABASE_MIGRATION_PLAN.md before use.
#
# PDF export uses the signed-in user's Supabase session token via /api/cookbook-pdf.
