# Foody Music — Supabase environment template
#
# Copy into .env.local alongside your OpenAI settings:
#   cp .env.supabase.example .env.local
#   # then merge with existing OPENAI_* values, or append these lines
#
# Get credentials from: Supabase Dashboard → Project Settings → API
# Full migration guide: docs/SUPABASE_MIGRATION_PLAN.md

# Project URL (Settings → API → Project URL)
# Example format: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Anon public key (Settings → API → anon public)
# Safe for browser use with Row Level Security enabled.
VITE_SUPABASE_ANON_KEY=

# Service role key (Settings → API → service_role) — server-side only.
# Required for trial enforcement on /api/concierge. Never expose in VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=
